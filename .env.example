# 1. EXOTEL TELEPHONY & VOICEBOT GATEWAY
# Real Indian virtual number configured on your Exotel Console
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
