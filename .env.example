EXOTEL_VOICEBOT_WS_PATH=/api/voice/exotel

# 2. SPEECH PROVIDER CONFIGURATION
# Options: 'sarvam' | 'google' | 'bhashini' | 'mock' (Default: 'sarvam')
STT_PROVIDER=sarvam

# Options: 'sarvam' | 'bhashini' | 'mock' (Default: 'sarvam')
TTS_PROVIDER=sarvam

# 3. OPTIONAL CLOUD AI KEYS (Strictly Non-Blocking Layer B)
