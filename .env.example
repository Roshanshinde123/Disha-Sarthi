# ====================================================================
# DISHA SARATHI (PS 26097) — ENVIRONMENT CONFIGURATION TEMPLATE
# PM-AJAY GIA Component (NSQF Skilling & Livelihood Voice Assistant)
# ====================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# Server-side only connection string with SSL
DATABASE_URL="postgresql://user:password@your-neon-host.aws.neon.tech/neondb?sslmode=require"

# 2. EXOTEL TELEPHONY & VOICEBOT GATEWAY
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_PHONE_NUMBER=09513886363
EXOTEL_VOICEBOT_WS_PATH=/api/voice/exotel

# 3. GATEWAY PORT & ENVIRONMENT
PORT=5173
VOICEBOT_PORT=8080
NODE_ENV=development

# 4. SPEECH PROVIDER CONFIGURATION (Layer A: Primary, Layer B: Fallback)
# Options: 'sarvam' | 'google' | 'bhashini' | 'mock'
STT_PROVIDER=sarvam

# Options: 'sarvam' | 'bhashini' | 'mock'
TTS_PROVIDER=sarvam

# 5. CLOUD AI API KEYS (Non-Blocking)
SARVAM_API_KEY=your_sarvam_api_key_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
GOOGLE_STT_API_KEY=your_google_stt_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 6. WHATSAPP BUSINESS API (Meta Cloud API)
# All values are SERVER-SIDE ONLY — never expose to Vite/React client code
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token_here
